# Postgres connection string. On Vercel + Neon use the POOLED connection string.
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Extra origins allowed to call the public booking API from a browser (comma-separated, no trailing slash).
# The site itself is always allowed; leave empty unless another site embeds the booking API.
ALLOWED_ORIGINS=http://localhost:3000

# Auth.js secret: generate with `npx auth secret` or `openssl rand -base64 32`.
AUTH_SECRET=

# Stripe TEST keys only (sk_test_...). The app refuses live keys.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Protects /api/cron/daily. Vercel sends it automatically as a Bearer token.
CRON_SECRET=

# "true" = nightly reset to sample data + demo staff login shown on the login page.
DEMO_MODE=true

# Booking emails via Gmail (optional; without these no emails are sent).
# Use a dedicated Gmail account with 2-Step Verification on, then create an App Password.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Optional: where "new booking request" alerts go, and the sender name.
OWNER_NOTIFY_EMAIL=
MAIL_FROM_NAME=Lakeview Cabins
